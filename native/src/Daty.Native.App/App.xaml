      <TextBlock Text="{Binding SelectedItem.Label,RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
