     </Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding Items.Count,RelativeSource={RelativeSource Self}}" Value="1"><Setter TargetName="arrow" Property="Visibility" Value="Collapsed"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
